{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release-base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BANEWFN_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux release",
      "description": "Native Linux build and STGZ package.",
      "inherits": "release-base",
      "installDir": "${sourceDir}/release/linux-release/stage"
    },
    {
      "name": "windows-release",
      "displayName": "Windows release (MinGW cross)",
      "description": "Cross-build a Windows x86_64 release bundle from WSL/Linux.",
      "inherits": "release-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-w64-x86_64.cmake",
      "installDir": "${sourceDir}/release/windows-release/stage"
    }
  ],
  "buildPresets": [
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "jobs": 0
    },
    {
      "name": "install-linux-release",
      "configurePreset": "linux-release",
      "targets": [
        "install"
      ],
      "jobs": 0
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "jobs": 0
    },
    {
      "name": "install-windows-release",
      "configurePreset": "windows-release",
      "targets": [
        "install"
      ],
      "jobs": 0
    }
  ],
  "packagePresets": [
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "generators": [
        "STGZ"
      ],
      "packageDirectory": "${sourceDir}/release/linux-release"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "generators": [
        "ZIP"
      ],
      "packageDirectory": "${sourceDir}/release/windows-release"
    }
  ],
  "workflowPresets": [
    {
      "name": "linux-release",
      "displayName": "Linux release workflow",
      "description": "Configure, build, install and package the Linux STGZ release.",
      "steps": [
        {
          "type": "configure",
          "name": "linux-release"
        },
        {
          "type": "build",
          "name": "linux-release"
        },
        {
          "type": "build",
          "name": "install-linux-release"
        },
        {
          "type": "package",
          "name": "linux-release"
        }
      ]
    },
    {
      "name": "windows-release",
      "displayName": "Windows release workflow",
      "description": "Configure, build, install and package the Windows ZIP release.",
      "steps": [
        {
          "type": "configure",
          "name": "windows-release"
        },
        {
          "type": "build",
          "name": "windows-release"
        },
        {
          "type": "build",
          "name": "install-windows-release"
        },
        {
          "type": "package",
          "name": "windows-release"
        }
      ]
    }
  ]
}
